# Runtime
NODE_ENV=development
PORT=2222

# Frontend + backend URLs
PUBLIC_BASE_URL=http://localhost:2222
CORS_ORIGINS=http://localhost:2222

# PostgreSQL
PGHOST=localhost
PGPORT=changeme
PGDATABASE=changeme
PGUSER=postgres
PGPASSWORD=change_me
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# Auth and verification
AUTH_COOKIE_NAME=app_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_SECRET=change_me_long_random_secret
VERIFY_TOKEN_SECRET=change_me_long_random_secret
VERIFY_TOKEN_TTL_MINUTES=1440

# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# SMTP and contact
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
MAIL_FROM=

# Email outbox worker
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_OUTBOX_DRY_RUN=false

# Frontend-exposed vars (must use VITE_ prefix)
VITE_APP_NAME=changeme
