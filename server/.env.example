NODE_ENV=development
PORT=5001
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-me
PGDATABASE=fullstack_test
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

AUTH_COOKIE_NAME=app_session
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=604800

VERIFY_TOKEN_SECRET=replace-with-a-long-random-secret
VERIFY_TOKEN_TTL_MINUTES=1440

WEBINAR_DEFAULT_PRICE_CENTS=0
WEBINAR_CURRENCY=PHP
WEBINAR_RESEND_COOLDOWN_SECONDS=300

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=mbcequena@gmail.com

EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_OUTBOX_DRY_RUN=true

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
